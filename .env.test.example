# Copy this file to .env.test and fill in a SCRATCH Postgres database — the
# test suite truncates tables between test files, so never point this at
# your real dev or production database.
#
# In CI (GitHub Actions), these are set directly as workflow env vars instead
# of a committed file — see .github/workflows/ci.yml.

NODE_ENV=test
SESSION_SECRET=test_session_secret_not_for_production
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kalpavruksha_test
DB_SSL=false
STORAGE_PROVIDER=local
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=TestPass123
SUPERADMIN_MOBILE=9999999999
