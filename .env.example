# Server
PORT=5000
SESSION_SECRET=change_this_to_a_long_random_string
# Set to "production" when actually deployed — enables secure (HTTPS-only)
# session cookies, HSTS, and JSON (rather than pretty-printed) logs. Leave
# unset for local development.
# NODE_ENV=production
# Optional — controls log verbosity (trace/debug/info/warn/error). Defaults
# to "debug" in development, "info" in production.
# LOG_LEVEL=info

# ------------------------------------------------------------------
# Database — any standard Postgres 13+ works (Supabase, Neon, Railway,
# Render Postgres, RDS, a local Postgres, etc.)
# ------------------------------------------------------------------
# Get this from your provider's dashboard. For Supabase specifically:
# Project Settings -> Database -> Connection string -> URI. Use the
# "Session pooler" (port 5432), NOT the "Transaction pooler" (port 6543),
# since this app uses a long-lived pg.Pool.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Set to "false" only if you are connecting to a local/self-hosted Postgres
# that does not use SSL. Supabase (and most managed providers) always
# require SSL, so leave this unset for those.
# DB_SSL=false

# ------------------------------------------------------------------
# File storage — pick ONE provider with STORAGE_PROVIDER, then fill in
# only that provider's section below. See README.md "Migrating storage
# providers" for full details.
# ------------------------------------------------------------------
STORAGE_PROVIDER=supabase
# STORAGE_PROVIDER=s3
# STORAGE_PROVIDER=local

# --- supabase (default) ---
# Get these from Supabase dashboard -> Project Settings -> API.
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (NOT the anon/public key) — uploads run
# server-side and need to bypass bucket RLS policies.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- s3 (any S3-compatible provider: AWS S3, Cloudflare R2, Backblaze B2,
#     DigitalOcean Spaces, Wasabi, self-hosted MinIO, etc.) ---
# S3_BUCKET=kalpavruksha-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_ENDPOINT=                     # leave blank for real AWS S3; set for R2/Spaces/MinIO/etc.
# S3_FORCE_PATH_STYLE=false        # set "true" for MinIO / some providers
# S3_PUBLIC_URL_BASE=              # optional CDN/custom public base URL

# --- local (server's own disk under public/uploads/ — no cloud account
#     needed, but most PaaS hosts have an EPHEMERAL filesystem; see README) ---
# (no extra env vars needed)

# Super Admin bootstrap (used by migrations/seed.js to create the first super admin)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe123
SUPERADMIN_MOBILE=9999999999
