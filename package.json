{
  "name": "kalpavruksha-kalyana",
  "version": "1.0.0",
  "description": "Matrimony service exclusively for Lingayats",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node migrations/seed.js",
    "migrate-storage": "node scripts/migrate-storage.js",
    "migrate-private-documents": "node scripts/migrate-private-documents.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"**/*.js\" --ignore-pattern node_modules --ignore-pattern public",
    "test:security": "jest --runInBand tests/security.test.js",
    "cleanup-uploads": "node scripts/cleanup-uploads.js",
    "db:init": "node scripts/init-db.js",
    "db:export": "node scripts/migrate-postgres.js export",
    "db:import": "node scripts/migrate-postgres.js import",
    "test:ui": "node scripts/check-ui.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.632.0",
    "basic-ftp": "^6.2.6",
    "bcrypt": "^6.0.0",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "mime-types": "^2.1.35",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pdfkit": "^0.15.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.17.1",
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "mysql2": "$mysql2"
  }
