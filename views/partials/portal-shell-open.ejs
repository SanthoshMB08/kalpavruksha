<%
/* Expected locals: portal ('admin'|'superadmin'), active (nav key), title, logoutUrl */
%>
<div class="admin-shell">
  <input type="checkbox" id="portalSidebarToggle" class="portal-sidebar-toggle-checkbox">

  <aside class="portal-sidebar">
    <div class="portal-sidebar-brand">
      <img src="/assets/logo/logo-mobile.png" class="portal-brand-logo" alt=""> Kalpavruksha Kalyana
      <span><%= t(portal === 'superadmin' ? 'Super Admin Portal' : 'Admin Portal') %></span>
    </div>
    <nav class="portal-nav">
      <% if (portal === 'superadmin') { %>
        <a href="/portal/super-secure-dashboard" class="<%= active === 'overview' ? 'active' : '' %>"><i class="fa-solid fa-gauge-high"></i> <%= t("Overview") %></a>
        <a href="/portal/super-secure-dashboard/admins" class="<%= active === 'admins' ? 'active' : '' %>"><i class="fa-solid fa-shield-halved"></i> <%= t("Sub-Admins") %></a>
        <a href="/portal/admin-dashboard/users" class="<%= active === 'users' ? 'active' : '' %>"><i class="fa-solid fa-user-check"></i> <%= t("User Approvals") %></a>
        <a href="/portal/admin-dashboard/profiles" class="<%= active === 'profiles' ? 'active' : '' %>"><i class="fa-solid fa-address-card"></i> <%= t("Manage Profiles") %></a>
        <a href="/portal/super-secure-dashboard/ads" class="<%= active === 'ads' ? 'active' : '' %>"><i class="fa-solid fa-bullhorn"></i> <%= t("Advertisements") %></a>
        <a href="/portal/super-secure-dashboard/stories" class="<%= active === 'stories' ? 'active' : '' %>"><i class="fa-solid fa-heart"></i> <%= t("Success Stories") %></a>
        <a href="/portal/super-secure-dashboard/messages" class="<%= active === 'messages' ? 'active' : '' %>"><i class="fa-solid fa-envelope"></i> <%= t("Contact Messages") %></a>
        <a href="/portal/super-secure-dashboard/trash" class="<%= active === 'trash' ? 'active' : '' %>"><i class="fa-solid fa-trash-can"></i> <%= t("Trash") %></a>
      <% } else { %>
        <a href="/portal/admin-dashboard" class="<%= active === 'overview' ? 'active' : '' %>"><i class="fa-solid fa-gauge-high"></i> <%= t("Overview") %></a>
        <a href="/portal/admin-dashboard/users" class="<%= active === 'users' ? 'active' : '' %>"><i class="fa-solid fa-user-check"></i> <%= t("User Approvals") %></a>
        <a href="/portal/admin-dashboard/profiles" class="<%= active === 'profiles' ? 'active' : '' %>"><i class="fa-solid fa-address-card"></i> <%= t("Profiles") %></a>
      <% } %>
    </nav>
    <div class="portal-sidebar-footer">
      <form action="<%= logoutUrl %>" method="post" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-outline-gold btn-sm btn-block" style="margin-top:10px; text-align:center; border-color:var(--gold-500); color:var(--gold-300);"><%= t("Logout") %></button>
        </form>
    </div>
  </aside>

  <label for="portalSidebarToggle" class="portal-sidebar-overlay"></label>

  <div class="portal-main">
    <div class="portal-topbar">
      <button type="button" data-portal-menu class="portal-menu-btn" aria-label="<%= t('Open menu') %>" aria-expanded="false"><i class="fa-solid fa-bars"></i></button>
      <div class="portal-topbar-title"><span class="portal-topbar-kicker"><%= t(portal === 'superadmin' ? 'Super admin' : 'Admin') %></span><%= typeof title !== 'undefined' ? t(title.replace(/^(Super )?Admin /, '')) : '' %></div>

      <div class="portal-language" role="group" aria-label="<%= t("Language") %>"><a href="<%= languageUrl('en') %>" lang="en" class="<%= currentLang === 'en' ? 'active' : '' %>">EN</a><a href="<%= languageUrl('kn') %>" lang="kn" class="<%= currentLang === 'kn' ? 'active' : '' %>">ಕನ್ನಡ</a></div>
      <div class="notif-bell-wrap">
        <button type="button" class="notif-bell-btn" id="notifBellBtn" aria-label="<%= t("Notifications") %>" aria-haspopup="true" aria-expanded="false">
          <i class="fa-solid fa-bell"></i>
          <span class="notif-badge" id="notifBadge" hidden>0</span>
        </button>
        <div class="notif-panel" id="notifPanel" hidden>
          <div class="notif-panel-header"><%= t("Activity") %></div>
          <div class="notif-panel-list" id="notifList"></div>
          <div class="notif-panel-empty" id="notifEmpty" hidden><%= t("No activity yet.") %></div>
          <div class="notif-panel-loading" id="notifLoading" hidden><i class="fa-solid fa-spinner fa-spin"></i> <%= t("Loading…") %></div>
        </div>
      </div>

      <div class="portal-topbar-user"><span class="portal-avatar"><%= currentUser.name.charAt(0).toUpperCase() %></span><span><%= currentUser.name %></span></div>
    </div>
    <div class="admin-body">
      <%- include('flash') %>
