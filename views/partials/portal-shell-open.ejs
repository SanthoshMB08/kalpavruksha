<%
/* Expected locals: portal ('admin'|'superadmin'), active (nav key), title, logoutUrl */
%>
<div class="admin-shell">
  <input type="checkbox" id="portalSidebarToggle" class="portal-sidebar-toggle-checkbox">

  <aside class="portal-sidebar">
    <div class="portal-sidebar-brand">
      <svg class="diya-mark" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="M12 2c1.4 2.6 3.4 4.7 3.4 7.8 0 2.9-1.7 5-3.4 5s-3.4-2.1-3.4-5C8.6 6.7 10.6 4.6 12 2z"/><path d="M4.5 19.2c0-2.9 3.1-3.8 7.5-3.8s7.5.9 7.5 3.8v1.3h-15v-1.3z" opacity=".92"/></svg> Kalpavruksha Kalyana
      <span><%= portal === 'superadmin' ? 'Super Admin Portal' : 'Admin Portal' %></span>
    </div>
    <nav class="portal-nav">
      <% if (portal === 'superadmin') { %>
        <a href="/portal/super-secure-dashboard" class="<%= active === 'overview' ? 'active' : '' %>"><i class="fa-solid fa-gauge-high"></i> Overview</a>
        <a href="/portal/super-secure-dashboard/admins" class="<%= active === 'admins' ? 'active' : '' %>"><i class="fa-solid fa-shield-halved"></i> Sub-Admins</a>
        <a href="/portal/super-secure-dashboard/ads" class="<%= active === 'ads' ? 'active' : '' %>"><i class="fa-solid fa-bullhorn"></i> Advertisements</a>
        <a href="/portal/super-secure-dashboard/stories" class="<%= active === 'stories' ? 'active' : '' %>"><i class="fa-solid fa-heart"></i> Success Stories</a>
      <% } else { %>
        <a href="/portal/admin-dashboard" class="<%= active === 'overview' ? 'active' : '' %>"><i class="fa-solid fa-gauge-high"></i> Overview</a>
        <a href="/portal/admin-dashboard/users" class="<%= active === 'users' ? 'active' : '' %>"><i class="fa-solid fa-user-check"></i> User Approvals</a>
        <a href="/portal/admin-dashboard/profiles" class="<%= active === 'profiles' ? 'active' : '' %>"><i class="fa-solid fa-address-card"></i> Profiles</a>
        <a href="/portal/admin-dashboard/stories" class="<%= active === 'stories' ? 'active' : '' %>"><i class="fa-solid fa-heart"></i> Success Stories</a>
      <% } %>
    </nav>
    <div class="portal-sidebar-footer">
      <% if (portal === 'superadmin') { %>
        <a href="/portal/admin-dashboard" class="btn btn-outline-gold btn-sm btn-block" style="margin-bottom:10px; text-align:center; border-color:var(--gold-500); color:var(--gold-300);">Open Admin Tools</a>
      <% } %>
      <a href="<%= logoutUrl %>" class="btn btn-outline-gold btn-sm btn-block" style="margin-top:10px; text-align:center; border-color:var(--gold-500); color:var(--gold-300);">Logout</a>
    </div>
  </aside>

  <label for="portalSidebarToggle" class="portal-sidebar-overlay"></label>

  <div class="portal-main">
    <div class="portal-topbar">
      <label for="portalSidebarToggle" class="portal-menu-btn" aria-label="Open menu"><i class="fa-solid fa-bars"></i></label>
      <div class="portal-topbar-title"><%= typeof title !== 'undefined' ? title : '' %></div>
      <div class="portal-topbar-user"><%= currentUser.name %></div>
    </div>
    <div class="admin-body">
      <%- include('flash') %>
