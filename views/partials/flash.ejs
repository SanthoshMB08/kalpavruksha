<% if (successMsg && successMsg.length) { %>
  <div class="success-box" role="status" aria-live="polite"><% successMsg.forEach(function(m) { %><%= m %><% }) %></div>
<% } %>
<% if (errorMsg && errorMsg.length) { %>
  <div class="error-box" role="alert"><% errorMsg.forEach(function(m) { %><%= m %><% }) %></div>
<% } %>
