    </div>
  </div>
</div>

<script>
(function () {
  var bellBtn = document.getElementById('notifBellBtn');
  var panel = document.getElementById('notifPanel');
  var badge = document.getElementById('notifBadge');
  var list = document.getElementById('notifList');
  var empty = document.getElementById('notifEmpty');
  var loading = document.getElementById('notifLoading');
  if (!bellBtn || !panel) return;

  // Position the fixed mobile panel exactly below the real topbar height
  // (varies slightly by device/font-scaling) instead of a hardcoded guess.
  function updateTopbarOffset() {
    var topbar = document.querySelector('.portal-topbar');
    if (topbar) {
      document.documentElement.style.setProperty('--notif-panel-top', (topbar.getBoundingClientRect().bottom + 8) + 'px');
    }
  }
  updateTopbarOffset();
  window.addEventListener('resize', updateTopbarOffset);

  var offset = 0;
  var limit = 15;
  var hasMore = true;
  var isLoading = false;
  var loadedOnce = false;

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.textContent = str == null ? '' : String(str);
    return div.innerHTML;
  }

  function renderItem(item) {
    var el = document.createElement('a');
    el.className = 'notif-item';
    el.href = '/portal/admin-dashboard/profiles/' + item.profileId;
    var when = new Date(item.createdAt).toLocaleString('en-IN');
    el.innerHTML =
      '<strong>' + escapeHtml(item.userName) + '</strong> is interested in ' +
      '<span>' + escapeHtml(item.profileName) + '</span>' +
      ' &mdash; Call: ' + escapeHtml(item.userMobile) +
      '<span class="notif-time">' + when + '</span>';
    return el;
  }

  function loadMore() {
    if (isLoading || !hasMore) return;
    isLoading = true;
    if (loading) loading.hidden = false;
    fetch('/portal/admin-dashboard/activity?offset=' + offset + '&limit=' + limit)
      .then(function (r) { return r.json(); })
      .then(function (data) {
        loadedOnce = true;
        (data.items || []).forEach(function (item) { list.appendChild(renderItem(item)); });
        offset += (data.items || []).length;
        hasMore = !!data.hasMore;
        if (typeof data.badgeCount === 'number') {
          if (data.badgeCount > 0) {
            badge.hidden = false;
            badge.textContent = data.badgeCount > 99 ? '99+' : String(data.badgeCount);
          } else {
            badge.hidden = true;
          }
        }
        if (empty) empty.hidden = list.children.length > 0;
      })
      .catch(function () {
        if (empty) { empty.hidden = false; empty.textContent = 'Could not load activity.'; }
      })
      .finally(function () {
        isLoading = false;
        if (loading) loading.hidden = true;
      });
  }

  bellBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    var opening = !panel.classList.contains('open');
    panel.classList.toggle('open');
    bellBtn.setAttribute('aria-expanded', opening ? 'true' : 'false');
    if (opening && !loadedOnce) loadMore();
  });

  document.addEventListener('click', function (e) {
    if (!panel.contains(e.target) && e.target !== bellBtn && !bellBtn.contains(e.target)) {
      panel.classList.remove('open');
      bellBtn.setAttribute('aria-expanded', 'false');
    }
  });

  list.addEventListener('scroll', function () {
    if (list.scrollTop + list.clientHeight >= list.scrollHeight - 40) loadMore();
  });

  // Load the badge count on page load even before the bell is clicked, so
  // it's visible at a glance (Instagram-style).
  loadMore();
})();
</script>

