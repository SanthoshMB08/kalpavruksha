<div class="pw-strength" data-password-strength-panel
     data-invalid-message="<%= t("Password must be 8+ characters with uppercase, lowercase, and a number, and no more than 72 UTF-8 bytes.") %>"
     data-label-empty="<%= t("Enter a password") %>"
     data-label-weak="<%= t("Weak") %>"
     data-label-fair="<%= t("Fair") %>"
     data-label-strong="<%= t("Strong") %>"
     data-label-too-long="<%= t("Too long") %>">
  <div class="pw-strength-heading">
    <span><%= t("Password strength") %></span>
    <span data-password-strength-label aria-live="polite"><%= t("Enter a password") %></span>
  </div>
  <div class="pw-strength-meter" role="progressbar" aria-label="<%= t("Password strength") %>"
       aria-valuemin="0" aria-valuemax="5" aria-valuenow="0">
    <span data-password-strength-bar></span>
  </div>
  <ul class="pw-checklist">
    <li data-password-rule="length"><i class="fa-solid fa-xmark rule-icon" aria-hidden="true"></i><span><%= t("At least 8 characters") %></span></li>
    <li data-password-rule="upper"><i class="fa-solid fa-xmark rule-icon" aria-hidden="true"></i><span><%= t("One uppercase letter") %></span></li>
    <li data-password-rule="lower"><i class="fa-solid fa-xmark rule-icon" aria-hidden="true"></i><span><%= t("One lowercase letter") %></span></li>
    <li data-password-rule="number"><i class="fa-solid fa-xmark rule-icon" aria-hidden="true"></i><span><%= t("One number") %></span></li>
    <li data-password-rule="bytes"><i class="fa-solid fa-xmark rule-icon" aria-hidden="true"></i><span><%= t("No more than 72 UTF-8 bytes") %></span></li>
  </ul>
</div>
