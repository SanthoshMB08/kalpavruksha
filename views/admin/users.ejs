<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <% const portal = currentUser.role === 'superadmin' ? 'superadmin' : 'admin'; %>
  <% const logoutUrl = portal === 'superadmin' ? '/portal/super-secure-logout' : '/portal/admin-logout'; %>
  <%- include('../partials/portal-shell-open', { portal, active, title, logoutUrl }) %>

      <div class="panel">
        <h3><i class="fa-solid fa-hourglass-half"></i> Pending Approvals</h3>
        <% if (pending.length === 0) { %>
          <div class="empty-state">No pending registrations right now.</div>
        <% } else { %>
          <div class="table-scroll">
          <table class="data-table">
            <thead><tr><th>Name</th><th>Gender</th><th>Mobile</th><th>Username</th><th>Registered</th><th>Action</th></tr></thead>
            <tbody>
              <% pending.forEach(function(u) { %>
                <tr>
                  <td data-label="Name"><%= u.name %></td>
                  <td data-label="Gender"><%= u.gender ? (u.gender === 'male' ? 'Male' : 'Female') : '—' %></td>
                  <td data-label="Mobile"><%= u.mobile_number %></td>
                  <td data-label="Username"><%= u.username %></td>
                  <td data-label="Registered"><%= new Date(u.created_at).toLocaleDateString('en-IN') %></td>
                  <td data-label="Action" class="row-actions">
                    <div class="row-actions-inner">
                      <form action="/portal/admin-dashboard/users/<%= u.id %>/approve" method="POST">
                        <button class="btn btn-gold btn-sm" type="submit">Approve Profile</button>
                      </form>
                      <form action="/portal/admin-dashboard/users/<%= u.id %>/reject" method="POST">
                        <button class="btn btn-danger btn-sm" type="submit">Deny Profile</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
        <% } %>
      </div>

      <div class="panel">
        <h3>
          <i class="fa-solid fa-users"></i> Active Members
          <span class="panel-head-actions">
            <button type="button" class="btn btn-gold btn-sm" data-open-modal="createUserModal"><i class="fa-solid fa-plus"></i> Create User</button>
          </span>
        </h3>
        <% if (members.length === 0) { %>
          <div class="empty-state">No approved members yet.</div>
        <% } else { %>
          <div class="table-scroll">
          <table class="data-table">
            <thead><tr><th>Name</th><th>Gender</th><th>Mobile</th><th>Username</th><th>Actions</th></tr></thead>
            <tbody>
              <% members.forEach(function(m) { %>
                <tr>
                  <td data-label="Name"><%= m.name %></td>
                  <td data-label="Gender"><%= m.gender ? (m.gender === 'male' ? 'Male' : 'Female') : '—' %></td>
                  <td data-label="Mobile"><%= m.mobile_number %></td>
                  <td data-label="Username"><%= m.username %></td>
                  <td data-label="Actions" class="row-actions">
                    <div class="row-menu">
                      <button type="button" class="row-menu-btn" aria-label="Actions for <%= m.username %>"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                      <div class="row-menu-dropdown">
                        <button type="button" data-open-modal="pwModal-<%= m.id %>"><i class="fa-solid fa-key"></i> Change Password</button>
                        <form action="/portal/admin-dashboard/users/<%= m.id %>/delete" method="POST" onsubmit="return confirm('Permanently delete user &quot;<%= m.username %>&quot;? This cannot be undone.');">
                          <button type="submit" class="danger"><i class="fa-solid fa-user-xmark"></i> Delete User</button>
                        </form>
                      </div>
                    </div>

                    <div class="modal-overlay" id="pwModal-<%= m.id %>">
                      <div class="modal-box modal-narrow">
                        <div class="modal-close"><button type="button" data-close-modal>&times;</button></div>
                        <div style="padding:0 24px 24px;">
                          <h3 style="margin-bottom:4px;">Change Password</h3>
                          <p style="font-size:0.82rem; color:#8a7156; margin-bottom:16px;"><%= m.username %></p>
                          <form action="/portal/admin-dashboard/users/<%= m.id %>/password" method="POST" onsubmit="return confirm('Reset password for <%= m.username %>?');">
                            <div class="field">
                              <label class="form-label">New Password</label>
                              <input type="password" name="password" minlength="8" required autofocus>
                            </div>
                            <div class="field" style="margin-top:16px;">
                              <button type="submit" class="btn btn-maroon btn-block">Update Password</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
        <% } %>
      </div>

      <!-- Create User modal -->
      <div class="modal-overlay" id="createUserModal">
        <div class="modal-box">
          <div class="modal-close"><button type="button" data-close-modal>&times;</button></div>
          <div style="padding:0 24px 24px;">
            <h3 style="margin-bottom:4px;"><i class="fa-solid fa-user-plus"></i> Direct User Creation</h3>
            <p style="font-size:0.82rem; color:#8a7156; margin-bottom:16px;">Bypasses approval, activates instantly.</p>
            <% if (formErrors && formErrors.length) { %>
              <div class="form-errors"><% formErrors.forEach(function(e) { %><div><i class="fa-solid fa-circle-exclamation"></i> <%= e %></div><% }) %></div>
            <% } %>
            <form class="form-grid" action="/portal/admin-dashboard/users/create-direct" method="POST">
              <div class="field">
                <label class="form-label">Full Name</label>
                <input type="text" name="name" value="<%= old.name || '' %>" pattern="[A-Za-z\\s.'-]+" title="Letters only, no numbers" required>
              </div>
              <div class="field">
                <label class="form-label">Mobile Number</label>
                <input type="text" name="mobile_number" value="<%= old.mobile_number || '' %>" pattern="[0-9]{10}" maxlength="10" title="Exactly 10 digits" required>
              </div>
              <div class="field">
                <label class="form-label">Username</label>
                <input type="text" name="username" value="<%= old.username || '' %>" required>
              </div>
              <div class="field">
                <label class="form-label">Gender <span class="field-tip" data-tip="Determines which members this account will be matched with.">?</span></label>
                <select name="gender" required>
                  <option value="">Select Gender</option>
                  <option value="male" <%= old.gender === 'male' ? 'selected' : '' %>>Male</option>
                  <option value="female" <%= old.gender === 'female' ? 'selected' : '' %>>Female</option>
                </select>
              </div>
              <div class="field">
                <label class="form-label">Password</label>
                <input type="password" name="password" required minlength="8">
              </div>
              <div class="field full">
                <button type="submit" class="btn btn-maroon">Create &amp; Activate User</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <% if (formErrors && formErrors.length) { %>
        <script>document.addEventListener('DOMContentLoaded', function () {
          var m = document.getElementById('createUserModal');
          if (m) m.classList.add('open');
        });</script>
      <% } %>
      <%- include('../partials/panel-ui-script') %>
  <%- include('../partials/portal-shell-close') %>
</body>
</html>
