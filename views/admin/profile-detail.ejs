<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <% const portal = currentUser.role === 'superadmin' ? 'superadmin' : 'admin'; %>
  <% const logoutUrl = portal === 'superadmin' ? '/portal/super-secure-logout' : '/portal/admin-logout'; %>
  <%- include('../partials/portal-shell-open', { portal, active, title, logoutUrl }) %>
    <a href="/portal/admin-dashboard/profiles" style="color:var(--maroon-800); font-weight:700; font-size:0.85rem;">&larr; Back to all profiles</a>

    <div class="panel" style="margin-top:16px; display:flex; gap:24px; flex-wrap:wrap;">
      <div style="display:flex; gap:12px;">
        <img src="/uploads/profiles/<%= profile.image_name %>" style="width:150px; height:150px; object-fit:cover; border-radius:var(--radius-lg); border:3px solid var(--gold-500);">
        <% if (profile.image_name_2) { %>
          <img src="/uploads/profiles/<%= profile.image_name_2 %>" style="width:150px; height:150px; object-fit:cover; border-radius:var(--radius-lg); border:3px solid var(--gold-500);">
        <% } %>
      </div>
      <div>
        <h2><%= profile.full_name %>, <%= profile.age %></h2>
        <p style="color:#8a7156;"><%= profile.occupation %> &middot; <%= profile.city %>, <%= profile.state %></p>
        <span class="badge <%= profile.marital_status === 'married' ? 'marital-badge-married' : 'marital-badge-unmarried' %>"><%= profile.marital_status === 'married' ? 'Married' : 'Unmarried' %></span>
        <div style="margin-top:12px; display:flex; gap:10px; flex-wrap:wrap;">
          <% if (profile.jathaka_pdf_name) { %>
            <a href="/uploads/jathaka/<%= profile.jathaka_pdf_name %>" target="_blank" class="btn btn-outline-gold btn-sm" style="border-color:var(--maroon-800); color:var(--maroon-800);">View Jathaka PDF</a>
          <% } %>
          <% if (profile.biodata_pdf_name) { %>
            <a href="/uploads/biodata/<%= profile.biodata_pdf_name %>" target="_blank" class="btn btn-outline-gold btn-sm" style="border-color:var(--maroon-800); color:var(--maroon-800);">View Bio-Data PDF</a>
          <% } %>
          <a href="/portal/admin-dashboard/profiles/<%= profile.id %>/pdf" class="btn btn-gold btn-sm"><i class="fa-solid fa-file-pdf"></i> Export as PDF</a>
          <% if (currentUser.role === 'superadmin') { %>
            <a href="/portal/super-secure-dashboard/profiles/<%= profile.id %>/edit" class="btn btn-maroon btn-sm">Edit Profile</a>
            <form action="/portal/admin-dashboard/profiles/<%= profile.id %>/delete" method="POST" onsubmit="return confirm('Permanently delete this profile? This cannot be undone.');">
              <button type="submit" class="btn btn-danger btn-sm">Delete Profile</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <div class="panel">
      <h3>Photos</h3>
      <p style="font-size:0.82rem; color:#8a7156; margin-bottom:12px;">Add or replace up to two profile photos.</p>
      <form action="/portal/admin-dashboard/profiles/<%= profile.id %>/photos" method="POST" enctype="multipart/form-data" class="form-grid">
        <div class="field"><label class="form-label">Photo 1</label><input type="file" name="profile_image" accept="image/*"></div>
        <div class="field"><label class="form-label">Photo 2</label><input type="file" name="profile_image_2" accept="image/*"></div>
        <div class="field full"><button type="submit" class="btn btn-gold btn-sm">Update Photos</button></div>
      </form>
    </div>

    <div class="panel">
      <h3>Marital Status</h3>
      <p style="font-size:0.82rem; color:#8a7156; margin-bottom:12px;">A profile marked "Married" is hidden from members immediately.</p>
      <form action="/portal/admin-dashboard/profiles/<%= profile.id %>/marital-status" method="POST" style="display:flex; gap:10px; align-items:center;">
        <select name="marital_status">
          <option value="unmarried" <%= profile.marital_status === 'unmarried' ? 'selected' : '' %>>Unmarried</option>
          <option value="married" <%= profile.marital_status === 'married' ? 'selected' : '' %>>Married</option>
        </select>
        <button type="submit" class="btn btn-outline-gold btn-sm" style="border-color:var(--maroon-800); color:var(--maroon-800);">Save Status</button>
      </form>
    </div>

    <div class="panel">
      <h3>Personal Details</h3>
      <table class="data-table">
        <tr><td><strong>Gender</strong></td><td><%= profile.gender === 'male' ? 'Male' : 'Female' %></td></tr>
        <tr><td><strong>Religion</strong></td><td><%= profile.religion %></td></tr>
        <tr><td><strong>Caste / Sub-caste</strong></td><td><%= profile.caste %> / <%= profile.subcaste %></td></tr>
        <tr><td><strong>Date of Birth</strong></td><td><%= profile.date_of_birth %> <% if (profile.time_of_birth) { %>(<%= profile.time_of_birth %>)<% } %></td></tr>
        <tr><td><strong>Rashi / Nakshatra</strong></td><td><%= profile.rashi %> / <%= profile.nakshatra %></td></tr>
        <tr><td><strong>Language</strong></td><td><%= profile.language %></td></tr>
        <tr><td><strong>Annual Salary</strong></td><td>₹<%= Number(profile.annual_salary).toLocaleString('en-IN') %></td></tr>
        <tr><td><strong>Phone</strong></td><td><%= profile.phone_number %></td></tr>
        <tr><td><strong>Address</strong></td><td><%= profile.address %></td></tr>
      </table>
    </div>

    <div class="panel">
      <h3>Family Details</h3>
      <table class="data-table">
        <tr><td><strong>Father</strong></td><td><%= profile.father_name %> &mdash; <%= profile.father_occupation %> (₹<%= Number(profile.father_salary).toLocaleString('en-IN') %>)</td></tr>
        <tr><td><strong>Mother</strong></td><td><%= profile.mother_name %> &mdash; <%= profile.mother_occupation %> (₹<%= Number(profile.mother_salary).toLocaleString('en-IN') %>)</td></tr>
        <tr><td><strong>Siblings</strong></td><td><%= profile.total_siblings %> total (<%= profile.male_siblings %> male, <%= profile.female_siblings %> female)</td></tr>
      </table>
    </div>

    <div class="panel">
      <h3>Assets &amp; Liabilities</h3>
      <p><strong>Assets:</strong> <%= profile.assets %></p>
      <% if (profile.loans) { %><p><strong>Loans:</strong> <%= profile.loans %></p><% } %>
    </div>
  <%- include('../partials/portal-shell-close') %>
</body>
</html>
