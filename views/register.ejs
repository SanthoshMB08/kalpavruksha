<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <div class="auth-wrap">
    <div class="auth-card">
      <h1><%= t('register.title') %></h1>
      <div class="subtitle"><%= t('register.subtitle') %></div>

      <% if (errors && errors.length) { %>
        <div class="error-box">
          <% errors.forEach(function(e) { %><div><%= t(e) %></div><% }) %>
        </div>
      <% } %>

      <form class="auth-form" action="/register" method="POST" id="registerForm" data-password-requires-consent="terms,privacy"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label class="form-label"><%= t('register.name') %></label>
          <input type="text" name="name" value="<%= old.name || '' %>" required>
        </div>
        <div class="field">
          <label class="form-label"><%= t('register.mobile') %></label>
          <input type="text" name="mobile_number" value="<%= old.mobile_number || '' %>" pattern="[0-9]{10}" maxlength="10" required>
        </div>
        <div class="field">
          <label class="form-label"><%= t('register.username') %></label>
          <input type="text" name="username" value="<%= old.username || '' %>" required>
        </div>
        <div class="field">
          <label class="form-label"><%= t('register.gender') %> <span class="field-tip" data-tip="<%= t("You'll only be matched with members of the opposite gender.") %>">?</span></label>
          <select name="gender" required>
            <option value=""><%= t('register.selectGender') %></option>
            <option value="male" <%= old.gender === 'male' ? 'selected' : '' %>><%= t('register.genderMale') %></option>
            <option value="female" <%= old.gender === 'female' ? 'selected' : '' %>><%= t('register.genderFemale') %></option>
          </select>
        </div>
        <div class="field">
          <label class="form-label"><%= t('register.password') %></label>
          <input type="password" name="password" id="password" data-password-strength-input required minlength="8" autocomplete="new-password">
          <%- include('partials/password-strength') %>
        </div>

        <label class="checkbox-row">
          <input type="checkbox" name="terms" id="terms">
          <%= t("I agree to the") %> <a href="/terms" target="_blank" rel="noopener" style="color:var(--maroon-800); text-decoration:underline;"><%= t("Terms of Use") %></a>
        </label>
        <label class="checkbox-row">
          <input type="checkbox" name="privacy" id="privacy">
          <%= t("I agree to the") %> <a href="/privacy" target="_blank" rel="noopener" style="color:var(--maroon-800); text-decoration:underline;"><%= t("Privacy Policy") %></a> &amp; <a href="/cookie-policy" target="_blank" rel="noopener" style="color:var(--maroon-800); text-decoration:underline;"><%= t("Cookie Policy") %></a>
        </label>

        <button type="submit" class="btn btn-gold btn-block" id="submitBtn" disabled><%= t('register.submit') %></button>
      </form>

      <div class="auth-footer-link"><%= t('register.haveAccount') %> <a href="/login" style="color:var(--maroon-800); font-weight:700;"><%= t('register.loginLink') %></a></div>
    </div>
  </div>

  <%- include('partials/footer') %>

</body>
</html>
