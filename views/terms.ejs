<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <div class="legal-page">
    <button type="button" class="legal-back" data-legal-back><%= t("← Back") %></button>
    <h1><%= t("Terms of Use") %></h1>
    <p class="legal-subtitle"><%= t("Service Agreement") %></p>
    <p class="legal-updated"><%= t("Last updated:") %> <%= new Date().toLocaleDateString(currentLang === 'kn' ? 'kn-IN' : 'en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>

    <p>
      <%= t("By registering on Kalpavruksha Kalyana, you acknowledge and agree to the following terms and conditions. These terms form part of our") %> <a href="/privacy"><%= t("Privacy Policy") %></a> <%= t("and our") %>
      <a href="/cookie-policy"><%= t("Cookie Policy") %></a><%= t(". If you do not agree with any part of these terms, please do not use this service.") %>
    </p>

    <section>
      <h2><%= t("1. Information Accuracy") %></h2>
      <p>
        <%= t("All information provided by members, including photographs, personal details, education, occupation, income, religion, caste, horoscope, and family information, is submitted by the respective users.") %>
      </p>
      <p>
        <%= t("We do not verify or guarantee the accuracy, authenticity, completeness, or reliability of any information published by members.") %>
      </p>
    </section>

    <section>
      <h2><%= t("2. User Responsibility") %></h2>
      <p><%= t("Members are solely responsible for:") %></p>
      <ul class="legal-list">
        <li><%= t("The information they provide.") %></li>
        <li><%= t("The photographs they upload.") %></li>
        <li><%= t("Their communication with other members.") %></li>
        <li><%= t("Independently verifying all details before making any personal or matrimonial decision.") %></li>
      </ul>
    </section>

    <section>
      <h2><%= t("3. No Guarantee of Marriage") %></h2>
      <p>
        <%= t("Our platform only provides matchmaking services by connecting registered members. We do not guarantee:") %>
      </p>
      <ul class="legal-list">
        <li><%= t("Marriage") %></li>
        <li><%= t("Suitable matches") %></li>
        <li><%= t("Compatibility") %></li>
        <li><%= t("Successful relationships") %></li>
        <li><%= t("Response from other members") %></li>
      </ul>
    </section>

    <section>
      <h2><%= t("4. Identity Verification") %></h2>
      <p>
        <%= t("Although we may provide profile verification features, verification does not guarantee the character, background, intentions, or authenticity of any member.") %>
      </p>
      <p>
        <%= t("Users are advised to conduct their own background checks before proceeding with any relationship or marriage.") %>
      </p>
    </section>

    <section>
      <h2><%= t("5. No Liability") %></h2>
      <p>
        <%= t("Kalpavruksha Kalyana, its owners, employees, affiliates, and partners shall not be liable for:") %>
      </p>
      <ul class="legal-list">
        <li><%= t("False or misleading information provided by users") %></li>
        <li><%= t("Fake or duplicate profiles") %></li>
        <li><%= t("Misrepresentation of identity") %></li>
        <li><%= t("Financial loss") %></li>
        <li><%= t("Emotional distress") %></li>
        <li><%= t("Marriage disputes") %></li>
        <li><%= t("Family disputes") %></li>
        <li><%= t("Divorce or separation") %></li>
        <li><%= t("Fraud committed by users") %></li>
        <li><%= t("Any loss arising from interactions between members") %></li>
      </ul>
      <p><%= t("All interactions are entirely at the user's own risk.") %></p>
    </section>

    <section>
      <h2><%= t("6. Privacy of Information") %></h2>
      <p><%= t("Users should exercise caution when sharing personal information.") %></p>
      <p>
        <%= t("We are not responsible for information voluntarily shared by users with other members outside the platform.") %>
      </p>
    </section>

    <section>
      <h2><%= t("7. User Conduct") %></h2>
      <p><%= t("Members shall not:") %></p>
      <ul class="legal-list">
        <li><%= t("Create fake profiles.") %></li>
        <li><%= t("Upload false information.") %></li>
        <li><%= t("Harass or threaten other members.") %></li>
        <li><%= t("Misuse contact information.") %></li>
        <li><%= t("Use the platform for illegal activities.") %></li>
      </ul>
      <p><%= t("Violation of these rules may result in account suspension or permanent removal.") %></p>
    </section>

    <section>
      <h2><%= t("8. Independent Verification") %></h2>
      <p>
        <%= t("We strongly recommend that members independently verify the following before making any commitment:") %>
      </p>
      <ul class="legal-list">
        <li><%= t("Identity") %></li>
        <li><%= t("Age") %></li>
        <li><%= t("Education") %></li>
        <li><%= t("Employment") %></li>
        <li><%= t("Income") %></li>
        <li><%= t("Family background") %></li>
        <li><%= t("Marital status") %></li>
        <li><%= t("Health information (where appropriate)") %></li>
      </ul>
    </section>

    <section>
      <h2><%= t("9. Limitation of Liability") %></h2>
      <p>
        <%= t("To the maximum extent permitted by applicable law, Kalpavruksha Kalyana shall not be responsible for any direct, indirect, incidental, consequential, or special damages arising from the use of the platform.") %>
      </p>
    </section>

    <section>
      <h2><%= t("10. Acceptance") %></h2>
      <p><%= t("By registering and using our services, you confirm that:") %></p>
      <ul class="legal-list">
        <li><%= t("You have read and understood these Terms.") %></li>
        <li><%= t("You agree that all matrimonial decisions are your own responsibility.") %></li>
        <li><%= t("You release Kalpavruksha Kalyana from any liability arising from the use of the platform.") %></li>
      </ul>
    </section>
  </div>

  <%- include('partials/footer') %>

  <%- include('partials/legal-back-script') %>
</body>
</html>
