<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>
  <main class="match-feed member-page match-feed-full">
    <%- include('partials/flash') %>
    <div class="member-page-heading saved-page-heading">
      <a href="/dashboard" class="member-back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> <%= t('saved.backToSearch') %></a>
      <span class="section-eyebrow"><%= t('nav.savedProfiles') %></span>
      <h1><%= t('saved.title') %></h1>
      <p><%= t('saved.subtitle') %></p>
    </div>

    <div class="profile-tabs">
      <a href="/saved-profiles?tab=saved" class="profile-tab <%= tab === 'saved' ? 'active' : '' %>">
        <i class="fa-solid fa-bookmark"></i> <%= t('saved.tabSaved') %> (<%= savedCount %>)
      </a>
      <a href="/saved-profiles?tab=interested" class="profile-tab <%= tab === 'interested' ? 'active' : '' %>">
        <i class="fa-solid fa-heart"></i> <%= t('saved.tabInterested') %> (<%= interestedCount %>)
      </a>
    </div>

    <% var list = tab === 'interested' ? interested : saved; %>
    <% if (list.length === 0) { %>
      <div class="member-empty-state">
        <span class="member-empty-icon"><i class="fa-<%= tab === 'interested' ? 'solid fa-heart' : 'solid fa-bookmark' %>" aria-hidden="true"></i></span>
        <h2><%= tab === 'interested' ? t('saved.emptyInterestedTitle') : t('saved.emptySavedTitle') %></h2>
        <% if (tab === 'interested') { %>
          <p><%= t('saved.emptyInterested') %></p>
        <% } else { %>
          <p><%= t('saved.emptySaved') %></p>
        <% } %>
        <a href="/dashboard" class="btn btn-gold"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> <%= t('saved.browseMatches') %></a>
      </div>
    <% } else { %>
      <div class="profile-grid">
        <% list.forEach(function(p) { %>
          <div class="profile-card">
            <div class="photo"><img loading="lazy" decoding="async" src="<%= fileUrl('profiles', p.image_name) %>" alt="<%= p.full_name %>"></div>
            <div class="info">
              <h4><%= p.full_name %>, <%= p.age %></h4>
              <div class="meta">
                <div><strong><%= t('dashboard.fieldCaste') %></strong> <%= t(p.caste) %></div>
                <div><strong><%= t('dashboard.fieldOccupation') %></strong> <%= t(p.occupation) %></div>
              </div>
            </div>
            <div class="actions">
              <button class="btn btn-outline-gold" style="border-color:var(--maroon-800); color:var(--maroon-800); flex:1;" data-open-profile-id="<%= p.id %>"><%= t('dashboard.viewDetails') %></button>
              <form action="/profile/<%= p.id %>/<%= tab === 'interested' ? 'withdraw-interest' : 'unsave' %>" method="POST" class="saved-list-remove-action"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline-gold profile-card-action profile-remove-action" aria-label="<%= t(tab === 'interested' ? 'Unlike' : 'Unsave') %>" title="<%= t(tab === 'interested' ? 'Unlike' : 'Unsave') %>">
                  <i class="fa-solid <%= tab === 'interested' ? 'fa-heart-crack' : 'fa-bookmark' %>" aria-hidden="true"></i><span class="profile-action-text"><%= t(tab === 'interested' ? 'Unlike' : 'Unsave') %></span>
                </button>
              </form>
              <button
                type="button"
                class="btn-share"
                data-profile-share
                data-share-name="<%= p.full_name %>"
                data-share-age="<%= p.age %>"
                data-share-caste="<%= t(p.caste) %>"
                data-share-occupation="<%= t(p.occupation) %>"
                aria-label="<%= t("Share profile") %>"
                title="<%= t("Share profile") %>"
              ><i class="fa-solid fa-share-nodes"></i></button>
            </div>
          </div>
        <% }) %>
      </div>
      <%- include('partials/pagination', { pageInfo, currentQuery }) %>
    <% } %>
  </main>

  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-box" id="modalBox">
      <div class="modal-close"><button data-close-profile-modal>&times;</button></div>
      <div id="modalContent" style="padding: 0 24px 24px;"><%= t("Loading...") %></div>
    </div>
  </div>

  <script nonce="<%= nonce %>">
  </script>
  <%- include('partials/whatsapp-share-script') %>

  <%- include('partials/footer') %>
</body>
</html>
