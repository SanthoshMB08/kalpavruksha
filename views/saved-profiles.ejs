<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>
  <main class="match-feed member-page match-feed-full">
    <%- include('partials/flash') %>
    <div class="member-page-heading saved-page-heading">
      <a href="/dashboard" class="member-back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> <%= t('saved.backToSearch') %></a>
      <span class="section-eyebrow"><%= t('nav.savedProfiles') %></span>
      <h1><%= t('saved.title') %></h1>
      <p><%= t('saved.subtitle') %></p>
    </div>

    <div class="profile-tabs">
      <a href="/saved-profiles?tab=saved" class="profile-tab <%= tab === 'saved' ? 'active' : '' %>">
        <i class="fa-solid fa-bookmark"></i> <%= t('saved.tabSaved') %> (<%= savedCount %>)
      </a>
      <a href="/saved-profiles?tab=interested" class="profile-tab <%= tab === 'interested' ? 'active' : '' %>">
        <i class="fa-solid fa-heart"></i> <%= t('saved.tabInterested') %> (<%= interestedCount %>)
      </a>
    </div>

    <% var list = tab === 'interested' ? interested : saved; %>
    <% if (list.length === 0) { %>
      <div class="member-empty-state">
        <span class="member-empty-icon"><i class="fa-<%= tab === 'interested' ? 'solid fa-heart' : 'solid fa-bookmark' %>" aria-hidden="true"></i></span>
        <h2><%= tab === 'interested' ? t('saved.emptyInterestedTitle') : t('saved.emptySavedTitle') %></h2>
        <% if (tab === 'interested') { %>
          <p><%= t('saved.emptyInterested') %></p>
        <% } else { %>
          <p><%= t('saved.emptySaved') %></p>
        <% } %>
        <a href="/dashboard" class="btn btn-gold"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> <%= t('saved.browseMatches') %></a>
      </div>
    <% } else { %>
      <div class="profile-grid">
        <% list.forEach(function(p) { %>
          <div class="profile-card">
            <div class="photo"><img src="<%= fileUrl('profiles', p.image_name) %>" alt="<%= p.full_name %>"></div>
            <div class="info">
              <h4><%= p.full_name %>, <%= p.age %></h4>
              <div class="meta">
                <div><strong><%= t('dashboard.fieldCaste') %></strong> <%= p.caste %></div>
                <div><strong><%= t('dashboard.fieldOccupation') %></strong> <%= p.occupation %></div>
              </div>
            </div>
            <div class="actions">
              <button class="btn btn-outline-gold" style="border-color:var(--maroon-800); color:var(--maroon-800); flex:1;" data-open-profile-id="<%= p.id %>"><%= t('dashboard.viewDetails') %></button>
              <button
                type="button"
                class="btn-whatsapp"
                data-whatsapp-share
                data-share-name="<%= p.full_name %>"
                data-share-age="<%= p.age %>"
                data-share-caste="<%= p.caste %>"
                data-share-occupation="<%= p.occupation %>"
                aria-label="Share on WhatsApp"
                title="Share on WhatsApp"
              ><i class="fa-brands fa-whatsapp"></i></button>
            </div>
          </div>
        <% }) %>
      </div>
      <%- include('partials/pagination', { pageInfo, currentQuery }) %>
    <% } %>
  </main>

  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-box" id="modalBox">
      <div class="modal-close"><button data-close-profile-modal>&times;</button></div>
      <div id="modalContent" style="padding: 0 24px 24px;">Loading...</div>
    </div>
  </div>

  <script nonce="<%= nonce %>">
    function openProfileModal(id) {
      const overlay = document.getElementById('modalOverlay');
      const content = document.getElementById('modalContent');
      content.innerHTML = 'Loading...';
      overlay.classList.add('open');
      fetch('/profile/' + id + '/modal')
        .then((r) => r.text())
        .then((html) => { content.innerHTML = html; })
        .catch(() => { content.innerHTML = '<p>Could not load profile.</p>'; });
    }
    function closeProfileModal() {
      document.getElementById('modalOverlay').classList.remove('open');
    }
    document.getElementById('modalOverlay').addEventListener('click', function (e) {
      if (e.target === this) closeProfileModal();
    });
    document.querySelectorAll('[data-open-profile-id]').forEach(function (btn) {
      btn.addEventListener('click', function () { openProfileModal(btn.getAttribute('data-open-profile-id')); });
    });
    document.querySelectorAll('[data-close-profile-modal]').forEach(function (btn) {
      btn.addEventListener('click', closeProfileModal);
    });
  </script>
  <%- include('partials/whatsapp-share-script') %>

  <%- include('partials/footer') %>
</body>
</html>
