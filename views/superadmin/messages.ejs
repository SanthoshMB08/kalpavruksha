<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/portal-shell-open', { portal: 'superadmin', active, title, logoutUrl: '/portal/super-secure-logout' }) %>

      <div class="panel">
        <h3><i class="fa-solid fa-envelope"></i> <%= t("Contact Messages") %></h3>
        <p style="font-size:0.82rem; color:#8a7156; margin-bottom:14px;"><%= t("Submissions from the home page \"Get in touch\" form.") %></p>
        <% if (messages.length === 0) { %>
          <div class="empty-state"><%= t("No messages yet.") %></div>
        <% } else { %>
          <div class="story-edit-list">
            <% messages.forEach(function(m) { %>
              <div class="story-edit-card">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px;">
                  <div>
                    <h4 style="margin-bottom:4px;">
                      <%= m.name %>
                      <% if (!m.is_read) { %><span class="badge badge-pending" style="margin-left:8px;"><%= t("New") %></span><% } %>
                    </h4>
                    <p style="font-size:0.82rem; color:#8a7156; margin-bottom:8px;">
                      <i class="fa-solid fa-phone"></i> <%= m.mobile %> &mdash; <%= new Date(m.created_at).toLocaleString(currentLang === 'kn' ? 'kn-IN' : 'en-IN') %>
                    </p>
                    <p style="color:#6b5638; font-size:0.9rem;"><%= m.message %></p>
                  </div>
                  <div class="row-menu">
                    <button type="button" class="row-menu-btn" aria-label="<%= t("Actions") %>"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                    <div class="row-menu-dropdown">
                      <% if (!m.is_read) { %>
                        <form action="/portal/super-secure-dashboard/messages/<%= m.id %>/read" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit"><i class="fa-solid fa-check"></i> <%= t("Mark as Read") %></button>
                        </form>
                      <% } %>
                      <form action="/portal/super-secure-dashboard/messages/<%= m.id %>/delete" method="POST" data-confirm="<%= t("Delete this message?") %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="danger"><i class="fa-solid fa-trash"></i> <%= t("Delete") %></button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
      <%- include('../partials/panel-ui-script') %>
  <%- include('../partials/portal-shell-close') %>
</body>
</html>
