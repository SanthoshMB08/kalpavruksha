<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/portal-shell-open', { portal:'superadmin', active, title, logoutUrl:'/portal/super-secure-logout' }) %>
<section class="page-intro"><div><span class="section-eyebrow"><%= t('Advertisements') %></span><h1><%= t('Ad manager') %></h1><p><%= t('One active advertisement per placement. Upload, preview and publish in one place.') %></p></div><a href="#newAd" class="btn btn-maroon"><i class="fa-solid fa-plus" aria-hidden="true"></i> <%= t('Create advertisement') %></a></section>
<div class="ad-manager-grid">
<section class="panel" id="newAd">
<h2><%= t('Create advertisement') %></h2>
<form class="form-grid" id="adUploadForm" action="/portal/super-secure-dashboard/ads" method="post" enctype="multipart/form-data">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="field full"><label for="adTitle"><%= t('Ad Title') %></label><input id="adTitle" name="ad_title" maxlength="100" required></div>
<div class="field full"><label for="adPlacement"><%= t('Placement') %></label><select id="adPlacement" name="placement" required><% Object.entries(adPlacements).forEach(([key,frame])=> { %><option value="<%= key %>"><%= t(frame.label) %></option><% }) %></select></div>
<div class="field full"><label for="adUrl"><%= t('Target URL (optional)') %></label><input id="adUrl" name="target_url" type="url" maxlength="255" placeholder="<%= t("https://") %>"></div>
<div class="field full"><label for="adExpiry"><%= t('Expiry (India time, IST)') %></label><input id="adExpiry" name="expires_at" type="datetime-local" required><small><%= t('Times use Asia/Kolkata (UTC +05:30).') %></small></div>
<div class="field full"><label for="adDesktop"><%= t('Desktop image') %></label><p id="desktopSize" class="frame-size"></p><input id="adDesktop" type="file" name="ad_image" accept="image/jpeg,image/png,image/webp" required></div>
<div class="field full"><label for="adMobile"><%= t('Mobile image (optional)') %></label><p id="mobileSize" class="frame-size"></p><input id="adMobile" type="file" name="ad_mobile_image" accept="image/jpeg,image/png,image/webp"><small><%= t('Without a mobile image, the desktop artwork is fitted into the mobile frame without cropping.') %></small></div>
<p class="field full muted"><%= t('JPG, PNG or WEBP. Maximum 5 MB per image. Keep important text inside the frame edges.') %></p>
<div class="field full"><button class="btn btn-maroon" type="submit"><i class="fa-solid fa-upload" aria-hidden="true"></i> <%= t('Publish advertisement') %></button></div>
</form>
</section>
<section class="panel ad-preview-panel" aria-labelledby="previewHeading">
<h2 id="previewHeading"><%= t('Preview') %></h2><p><%= t('Your artwork is fitted to the frame without cropping.') %></p>
<div class="ad-preview-device"><h3><i class="fa-solid fa-desktop" aria-hidden="true"></i> <%= t('Desktop') %></h3><div class="creative-preview" id="desktopPreview"><span><%= t('Choose an image to preview') %></span><img alt="<%= t('Desktop preview') %>" hidden></div></div>
<div class="ad-preview-device"><h3><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i> <%= t('Mobile') %></h3><div class="creative-preview mobile-preview" id="mobilePreview"><span><%= t('Choose an image to preview') %></span><img alt="<%= t('Mobile preview') %>" hidden></div></div>
<p id="adImageFeedback" class="muted" role="status"></p>
</section>
</div>
<section class="panel">
<h2><%= t('Advertisements') %> <span class="count-chip"><%= ads.length %></span></h2>
<div class="ad-list">
<% ads.forEach(ad=>{ const expired=ad.expires_at && new Date(ad.expires_at)<=new Date(); const live=ad.is_active&&!expired; %>
<article class="ad-management-card">
<img class="ad-thumb" loading="lazy" src="<%= fileUrl('ads',ad.image_name) %>" alt="<%= ad.ad_title %>">
<div class="ad-card-copy"><h3><%= ad.ad_title %></h3><p><%= t(adPlacements[ad.placement].label) %></p><span class="badge <%= live?'badge-approved':'badge-rejected' %>"><%= t(t(expired?'Expired':live?'Active':'Inactive')) %></span><p><%= t('Expires') %>: <%= ad.expires_at ? formatDate(ad.expires_at, {dateStyle:'medium',timeStyle:'short'}) : '—' %> <%= t("IST") %></p></div>
<div class="ad-card-actions">
<% if(!expired) { %><form action="/portal/super-secure-dashboard/ads/<%= ad.id %>/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-gold"><%= t(live?'Deactivate':'Activate') %></button></form><% } %>
<details><summary><%= t('Set new expiry') %></summary><form action="/portal/super-secure-dashboard/ads/<%= ad.id %>/reactivate" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="expiry-<%= ad.id %>"><%= t('Expiry (India time, IST)') %></label><input id="expiry-<%= ad.id %>" name="expires_at" type="datetime-local" required><button class="btn btn-maroon"><%= t('Activate with New Expiry') %></button></form></details>
<form action="/portal/super-secure-dashboard/ads/<%= ad.id %>/delete" method="post" data-confirm="<%= t('Delete this ad?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger"><%= t('Delete') %></button></form>
</div></article><% }) %>
<% if(!ads.length){ %><div class="empty-state"><i class="fa-solid fa-image" aria-hidden="true"></i><p><%= t('No advertisements uploaded yet.') %></p></div><% } %>
</div>
</section>
<script nonce="<%= nonce %>">window.AD_FRAMES = <%- safeJson(adPlacements) %>;</script>
<script src="/js/ad-editor.js" defer></script>
<%- include('../partials/portal-shell-close') %>
</body></html>
