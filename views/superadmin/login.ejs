<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="auth-wrap" style="min-height:100vh; background:var(--charcoal-900); background-image: radial-gradient(circle at 80% 20%, rgba(234,179,8,0.1), transparent 55%);">
    <div class="auth-card" style="border-top-color: var(--maroon-800);">
      <h1><%= t("Super Admin") %></h1>
      <div class="subtitle"><%= t("Command Central — Restricted Access") %></div>
      <% if (error) { %><div class="error-box"><%= t(error) %></div><% } %>
      <form class="auth-form" action="/portal/super-secure-login" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label class="form-label"><%= t("Username") %></label>
          <input type="text" name="username" required autofocus>
        </div>
        <div class="field">
          <label class="form-label"><%= t("Password") %></label>
          <div class="password-field">
            <input type="password" name="password" required>
            <button type="button" class="password-toggle-btn" aria-label="<%= t("Show password") %>"><i class="fa-solid fa-eye"></i></button>
          </div>
        </div>
        <button type="submit" class="btn btn-maroon btn-block"><%= t("Login") %></button>
      </form>
    </div>
  </div>
  <%- include('../partials/password-toggle-script') %>
</body>
</html>
