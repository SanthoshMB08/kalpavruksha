<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/portal-shell-open', { portal: 'superadmin', active: 'profiles', title, logoutUrl: '/portal/super-secure-logout' }) %>

  <a href="/portal/admin-dashboard/profiles/<%= profile.id %>" style="color:var(--maroon-800); font-weight:700; font-size:0.85rem;">&larr; Back to profile</a>
  <div class="panel">
    <h3><i class="fa-solid fa-pen-to-square"></i> Edit Profile — Super Admin</h3>
    <p style="font-size:0.82rem; color:#8a7156; margin-bottom:12px;">Super Admin can edit every field, including gender and the horoscope document. Leave a file field empty to keep the existing file.</p>
    <% if (errors && errors.length) { %>
      <div class="form-errors"><% errors.forEach(function(e) { %><div><i class="fa-solid fa-circle-exclamation"></i> <%= e %></div><% }) %></div>
    <% } %>
    <form class="form-sectioned" action="/portal/super-secure-dashboard/profiles/<%= profile.id %>/edit" method="POST" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- ================= Basic Details ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-user"></i> Basic Details</div>
        <div class="form-grid">
          <div class="field"><label class="form-label">Phone Number <span class="field-tip" data-tip="Changing this does not change the linked login account's number.">?</span></label><input type="text" name="phone_number" value="<%= profile.phone_number %>" pattern="[0-9]{10}" maxlength="10" required></div>
          <div class="field"><label class="form-label">Full Name</label><input type="text" name="full_name" value="<%= profile.full_name %>" pattern="[A-Za-z\s.'-]+" required></div>
          <div class="field"><label class="form-label">Marital Status</label>
            <select name="marital_status" id="maritalStatusSelect" required>
              <% opts.MARITAL_STATUS_OPTIONS.forEach(function(o) { %>
                <option value="<%= o.value %>" <%= profile.marital_status === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="field"><label class="form-label">Date of Birth</label><input type="date" name="date_of_birth" value="<%= profile.date_of_birth ? new Date(profile.date_of_birth).toISOString().slice(0,10) : '' %>" required></div>
          <div class="field"><label class="form-label">Birth Place</label><input type="text" name="birth_place" value="<%= profile.birth_place || '' %>" pattern="[A-Za-z\s.'-]+"></div>
          <div class="field"><label class="form-label">Gender</label>
            <select name="gender" required>
              <option value="male" <%= profile.gender === 'male' ? 'selected' : '' %>>Male (Groom)</option>
              <option value="female" <%= profile.gender === 'female' ? 'selected' : '' %>>Female (Bride)</option>
            </select>
          </div>
          <div class="field"><label class="form-label">Willing to Marry Other Caste?</label>
            <select name="willing_other_caste">
              <option value="">Select</option>
              <% opts.YES_NO_OPTIONS.forEach(function(o) { %>
                <option value="<%= o.value %>" <%= profile.willing_other_caste === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="field conditional-field visible" id="hasChildrenField"><label class="form-label">Do you have children?</label>
            <select name="has_children" id="hasChildrenSelect">
              <option value="">Select</option>
              <% opts.CHILDREN_OPTIONS.forEach(function(o) { %>
                <option value="<%= o.value %>" <%= profile.has_children === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="field conditional-field <%= profile.has_children && profile.has_children.startsWith('yes') ? 'visible' : '' %>" id="numChildrenField"><label class="form-label">Number of Children</label>
            <input type="number" name="number_of_children" min="0" max="20" value="<%= profile.number_of_children || '' %>">
          </div>
        </div>
      </div>

      <!-- ================= Profile Photos ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-camera"></i> Profile Photos</div>
        <div class="form-grid">
          <div class="field"><label class="form-label">Replace Photo 1 <span class="field-tip" data-tip="Leave empty to keep the current photo.">?</span></label><input type="file" name="profile_image" accept="image/*">
            <small style="color:#a08a6a; font-size:0.75rem;">Max 5MB — JPG, PNG, or WEBP</small></div>
          <div class="field"><label class="form-label">Replace Photo 2</label><input type="file" name="profile_image_2" accept="image/*">
            <small style="color:#a08a6a; font-size:0.75rem;">Max 5MB — JPG, PNG, or WEBP</small></div>
        </div>
      </div>

      <!-- ================= Religion Details ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-place-of-worship"></i> Religion Details</div>
        <div class="form-grid">
          <div class="field"><label class="form-label">Religion</label>
            <select name="religion" id="religionSelect" required>
              <option value="">Select Religion</option>
              <% opts.RELIGION_OPTIONS.forEach(function(o) { %>
                <option value="<%= o.value %>" <%= profile.religion === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="field conditional-field <%= profile.religion === 'other' ? 'visible' : '' %>" id="religionOtherField"><label class="form-label">Please specify religion</label><input type="text" name="religion_other" value="<%= profile.religion_other || '' %>"></div>
          <div class="field"><label class="form-label">Caste</label>
            <input type="text" name="caste" id="casteInput" list="casteOptionsList" value="<%= profile.caste || '' %>">
            <datalist id="casteOptionsList"></datalist>
          </div>
          <div class="field conditional-field <%= profile.caste === 'Other' ? 'visible' : '' %>" id="casteOtherField"><label class="form-label">Please specify caste</label><input type="text" name="caste_other" value="<%= profile.caste_other || '' %>"></div>
          <div class="field"><label class="form-label">Sub-caste</label><input type="text" name="subcaste" value="<%= profile.subcaste || '' %>"></div>
        </div>
      </div>

      <!-- ================= Education / Occupation Details ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-graduation-cap"></i> Education / Occupation Details</div>
        <div class="form-grid">
          <div class="field"><label class="form-label">Highest Education</label>
            <input type="text" name="education" list="educationOptionsList" value="<%= profile.education || '' %>">
            <datalist id="educationOptionsList"><% opts.EDUCATION_OPTIONS.forEach(function(e) { %><option value="<%= e %>"><% }) %></datalist>
          </div>
          <div class="field"><label class="form-label">Employed In</label>
            <select name="employed_in" id="employedInSelect">
              <option value="">Select</option>
              <% opts.EMPLOYED_IN_OPTIONS.forEach(function(o) { %>
                <option value="<%= o.value %>" <%= profile.employed_in === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="field conditional-field <%= profile.employed_in === 'other' ? 'visible' : '' %>" id="employedInOtherField"><label class="form-label">Please specify</label><input type="text" name="employed_in_other" value="<%= profile.employed_in_other || '' %>"></div>
          <div class="field"><label class="form-label">Occupation</label>
            <input type="text" name="occupation" id="occupationInput" list="occupationOptionsList" value="<%= profile.occupation || '' %>">
            <datalist id="occupationOptionsList"><% opts.OCCUPATION_CATEGORY_OPTIONS.forEach(function(o) { %><option value="<%= o %>"><% }) %></datalist>
          </div>
          <div class="field conditional-field <%= profile.occupation === 'Other' ? 'visible' : '' %>" id="occupationOtherField"><label class="form-label">Please specify occupation</label><input type="text" name="occupation_other" value="<%= profile.occupation_other || '' %>"></div>
          <div class="field"><label class="form-label">Company Name</label><input type="text" name="company_name" value="<%= profile.company_name || '' %>"></div>
          <div class="field"><label class="form-label">Designation</label><input type="text" name="designation" value="<%= profile.designation || '' %>"></div>
          <div class="field"><label class="form-label">Annual Income</label>
            <select name="annual_income_band">
              <option value="">Select</option>
              <% opts.INCOME_BAND_OPTIONS.forEach(function(i) { %>
                <option value="<%= i %>" <%= profile.annual_income_band === i ? 'selected' : '' %>><%= i %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>

      <!-- ================= Horoscope Information ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-star-and-crescent"></i> Horoscope Information</div>
        <div class="form-grid">
          <div class="field"><label class="form-label">Have Dosh?</label>
            <select name="has_dosh">
              <option value="">Select</option>
              <% opts.YES_NO_OPTIONS.forEach(function(o) { %>
                <option value="<%= o.value %>" <%= profile.has_dosh === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="field"><label class="form-label">Time of Birth</label><input type="time" name="time_of_birth" value="<%= profile.time_of_birth || '' %>"></div>
          <div class="field">
            <label class="form-label">Rasi</label>
            <select name="rashi" id="rashi" required>
              <option value="">Select Rasi</option>
              <option value="Mesha" <%= profile.rashi === 'Mesha' ? 'selected' : '' %>>Mesha (Aries)</option>
              <option value="Vrishabha" <%= profile.rashi === 'Vrishabha' ? 'selected' : '' %>>Vrishabha (Taurus)</option>
              <option value="Mithuna" <%= profile.rashi === 'Mithuna' ? 'selected' : '' %>>Mithuna (Gemini)</option>
              <option value="Karka" <%= profile.rashi === 'Karka' ? 'selected' : '' %>>Karka (Cancer)</option>
              <option value="Simha" <%= profile.rashi === 'Simha' ? 'selected' : '' %>>Simha (Leo)</option>
              <option value="Kanya" <%= profile.rashi === 'Kanya' ? 'selected' : '' %>>Kanya (Virgo)</option>
              <option value="Tula" <%= profile.rashi === 'Tula' ? 'selected' : '' %>>Tula (Libra)</option>
              <option value="Vrischika" <%= profile.rashi === 'Vrischika' ? 'selected' : '' %>>Vrischika (Scorpio)</option>
              <option value="Dhanu" <%= profile.rashi === 'Dhanu' ? 'selected' : '' %>>Dhanu (Sagittarius)</option>
              <option value="Makara" <%= profile.rashi === 'Makara' ? 'selected' : '' %>>Makara (Capricorn)</option>
              <option value="Kumbha" <%= profile.rashi === 'Kumbha' ? 'selected' : '' %>>Kumbha (Aquarius)</option>
              <option value="Meena" <%= profile.rashi === 'Meena' ? 'selected' : '' %>>Meena (Pisces)</option>
            </select>
          </div>
          <div class="field">
            <label class="form-label">Nakshatra (Star)</label>
            <select name="nakshatra" id="nakshatra" data-current-nakshatra="<%= profile.nakshatra %>" required>
              <option value="<%= profile.nakshatra %>"><%= profile.nakshatra %></option>
            </select>
          </div>
          <div class="field full"><label class="form-label">Replace Horoscope PDF <span class="field-tip" data-tip="Only Super Admin can re-attach this document.">?</span></label>
            <input type="file" name="jathaka_pdf" accept="application/pdf">
            <small style="color:#a08a6a; font-size:0.75rem;">Max 15MB — PDF only</small></div>
          <div class="field full"><label class="form-label">Replace Bio-Data PDF</label>
            <input type="file" name="biodata_pdf" accept="application/pdf">
            <small style="color:#a08a6a; font-size:0.75rem;">Max 15MB — PDF only</small></div>
        </div>
      </div>

      <!-- ================= Family Details ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-people-roof"></i> Family Details</div>
        <div class="form-grid">
          <div class="field"><label class="form-label">Family Type</label>
            <select name="family_type">
              <option value="">Select</option>
              <% opts.FAMILY_TYPE_OPTIONS.forEach(function(f) { %><option value="<%= f %>" <%= profile.family_type === f ? 'selected' : '' %>><%= f %></option><% }) %>
            </select>
          </div>
          <div class="field"><label class="form-label">Family Values</label>
            <select name="family_values">
              <option value="">Select</option>
              <% opts.FAMILY_VALUES_OPTIONS.forEach(function(f) { %><option value="<%= f %>" <%= profile.family_values === f ? 'selected' : '' %>><%= f %></option><% }) %>
            </select>
          </div>
          <div class="field"><label class="form-label">Family Status</label>
            <select name="family_status">
              <option value="">Select</option>
              <% opts.FAMILY_STATUS_OPTIONS.forEach(function(f) { %><option value="<%= f %>" <%= profile.family_status === f ? 'selected' : '' %>><%= f %></option><% }) %>
            </select>
          </div>
          <div class="field"><label class="form-label">Father's Name</label><input type="text" name="father_name" value="<%= profile.father_name %>" pattern="[A-Za-z\s.'-]+" required></div>
          <div class="field"><label class="form-label">Father's Occupation</label><input type="text" name="father_occupation" value="<%= profile.father_occupation %>" required></div>
          <div class="field"><label class="form-label">Mother's Name</label><input type="text" name="mother_name" value="<%= profile.mother_name %>" pattern="[A-Za-z\s.'-]+" required></div>
          <div class="field"><label class="form-label">Mother's Occupation</label><input type="text" name="mother_occupation" value="<%= profile.mother_occupation %>" required></div>
          <div class="field full"><small style="color:#a08a6a;">Sibling details (optional)</small></div>
          <div class="field"><label class="form-label">Number of Brothers</label><input type="number" name="num_brothers" min="0" value="<%= profile.num_brothers || 0 %>"></div>
          <div class="field"><label class="form-label">Married Brothers</label><input type="number" name="married_brothers" min="0" value="<%= profile.married_brothers || 0 %>"></div>
          <div class="field"><label class="form-label">Number of Sisters</label><input type="number" name="num_sisters" min="0" value="<%= profile.num_sisters || 0 %>"></div>
          <div class="field"><label class="form-label">Married Sisters</label><input type="number" name="married_sisters" min="0" value="<%= profile.married_sisters || 0 %>"></div>
        </div>
      </div>

      <!-- ================= Location Details ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-location-dot"></i> Location Details</div>
        <div class="form-grid">
          <div class="field"><label class="form-label">Country</label>
            <input type="text" name="country" list="countryOptionsList" value="<%= profile.country || 'India' %>" required>
            <datalist id="countryOptionsList"><% opts.COUNTRIES.forEach(function(c) { %><option value="<%= c %>"><% }) %></datalist>
          </div>
          <div class="field"><label class="form-label">State</label>
            <input type="text" name="state" list="stateOptionsList" value="<%= profile.state || '' %>">
            <datalist id="stateOptionsList"><% opts.INDIA_STATES.forEach(function(s) { %><option value="<%= s %>"><% }) %></datalist>
          </div>
          <div class="field"><label class="form-label">City</label><input type="text" name="city" value="<%= profile.city %>" pattern="[A-Za-z\s.'-]+" required></div>
          <div class="field full"><label class="form-label">Address</label><textarea name="address" rows="2" required><%= profile.address %></textarea></div>
        </div>
      </div>

      <!-- ================= Habits & Hobbies ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-heart-circle-check"></i> Habits &amp; Hobbies</div>
        <div class="form-grid">
          <div class="field"><label class="form-label">Eating Habit</label>
            <select name="eating_habit">
              <option value="">Select</option>
              <% opts.EATING_HABIT_OPTIONS.forEach(function(o) { %><option value="<%= o %>" <%= profile.eating_habit === o ? 'selected' : '' %>><%= o %></option><% }) %>
            </select>
          </div>
          <div class="field"><label class="form-label">Smoking Habit</label>
            <select name="smoking_habit">
              <option value="">Select</option>
              <% opts.SMOKING_HABIT_OPTIONS.forEach(function(o) { %><option value="<%= o %>" <%= profile.smoking_habit === o ? 'selected' : '' %>><%= o %></option><% }) %>
            </select>
          </div>
          <div class="field"><label class="form-label">Drinking Habit</label>
            <select name="drinking_habit">
              <option value="">Select</option>
              <% opts.DRINKING_HABIT_OPTIONS.forEach(function(o) { %><option value="<%= o %>" <%= profile.drinking_habit === o ? 'selected' : '' %>><%= o %></option><% }) %>
            </select>
          </div>
          <div class="field"><label class="form-label">Mother Tongue</label>
            <select name="mother_tongue" id="motherTongueSelect">
              <option value="">Select</option>
              <% opts.MOTHER_TONGUE_OPTIONS.forEach(function(o) { %><option value="<%= o %>" <%= profile.mother_tongue === o ? 'selected' : '' %>><%= o %></option><% }) %>
            </select>
          </div>
          <div class="field conditional-field <%= profile.mother_tongue === 'Other' ? 'visible' : '' %>" id="motherTongueOtherField"><label class="form-label">Please specify</label><input type="text" name="mother_tongue_other" value="<%= profile.mother_tongue_other || '' %>"></div>
        </div>
      </div>

      <!-- ================= Assets ================= -->
      <div class="form-section-card">
        <div class="form-section-title"><i class="fa-solid fa-vault"></i> Assets</div>
        <div class="form-grid">
          <div class="field full"><label class="form-label">Assets</label><textarea name="assets" rows="2" required><%= profile.assets %></textarea></div>
          <div class="field full"><label class="form-label">Loans (if any)</label><textarea name="loans" rows="2"><%= profile.loans || '' %></textarea></div>
        </div>
      </div>

      <div class="field full"><button type="submit" class="btn btn-gold">Save Changes</button></div>
    </form>
  </div>

  <script nonce="<%= nonce %>">
const rashiNakshatras = {
  Mesha: ["Ashwini", "Bharani", "Krittika"],
  Vrishabha: ["Krittika", "Rohini", "Mrigashira"],
  Mithuna: ["Mrigashira", "Ardra", "Punarvasu"],
  Karka: ["Punarvasu", "Pushya", "Ashlesha"],
  Simha: ["Magha", "Purva Phalguni", "Uttara Phalguni"],
  Kanya: ["Uttara Phalguni", "Hasta", "Chitra"],
  Tula: ["Chitra", "Swati", "Vishakha"],
  Vrischika: ["Vishakha", "Anuradha", "Jyeshtha"],
  Dhanu: ["Mula", "Purva Ashadha", "Uttara Ashadha"],
  Makara: ["Uttara Ashadha", "Shravana", "Dhanishta"],
  Kumbha: ["Dhanishta", "Shatabhisha", "Purva Bhadrapada"],
  Meena: ["Purva Bhadrapada", "Uttara Bhadrapada", "Revati"]
};

const rashiSelect = document.getElementById("rashi");
const nakshatraSelect = document.getElementById("nakshatra");
const currentNakshatra = nakshatraSelect.getAttribute("data-current-nakshatra") || "";

function fillNakshatras(selectedRashi, preselect) {
  nakshatraSelect.innerHTML = '<option value="">Select Nakshatra</option>';
  if (!selectedRashi || !rashiNakshatras[selectedRashi]) return;
  rashiNakshatras[selectedRashi].forEach(function (nakshatra) {
    const option = document.createElement("option");
    option.value = nakshatra;
    option.textContent = nakshatra;
    if (nakshatra === preselect) option.selected = true;
    nakshatraSelect.appendChild(option);
  });
  if (preselect && !rashiNakshatras[selectedRashi].includes(preselect)) {
    const option = document.createElement("option");
    option.value = preselect;
    option.textContent = preselect + " (existing value)";
    option.selected = true;
    nakshatraSelect.appendChild(option);
  }
}
fillNakshatras(rashiSelect.value, currentNakshatra);
rashiSelect.addEventListener("change", function () { fillNakshatras(this.value, null); });

function toggleConditional(el, show) {
  if (!el) return;
  el.classList.toggle('visible', show);
}

const CASTE_OPTIONS_BY_RELIGION = <%- JSON.stringify(opts.CASTE_OPTIONS_BY_RELIGION) %>;
(function () {
  const religionSelect = document.getElementById('religionSelect');
  const religionOtherField = document.getElementById('religionOtherField');
  const casteInput = document.getElementById('casteInput');
  const casteOptionsList = document.getElementById('casteOptionsList');
  const casteOtherField = document.getElementById('casteOtherField');
  const currentCaste = casteInput.value;

  function updateCaste(preserveCurrent) {
    const religion = religionSelect.value;
    toggleConditional(religionOtherField, religion === 'other');
    const casteList = CASTE_OPTIONS_BY_RELIGION[religion];
    casteOptionsList.innerHTML = '';
    if (casteList) {
      casteInput.disabled = false;
      casteInput.placeholder = 'Type to search...';
      casteList.forEach(function (c) {
        const opt = document.createElement('option');
        opt.value = c;
        casteOptionsList.appendChild(opt);
      });
      if (!preserveCurrent) casteInput.value = '';
    } else {
      casteInput.disabled = true;
      casteInput.value = '';
      casteInput.placeholder = 'Not available for this religion yet';
      toggleConditional(casteOtherField, false);
    }
  }
  casteInput.addEventListener('input', function () {
    toggleConditional(casteOtherField, casteInput.value === 'Other');
  });
  religionSelect.addEventListener('change', function () { updateCaste(false); });
  updateCaste(true);
  casteInput.value = currentCaste;
})();

(function () {
  const maritalSelect = document.getElementById('maritalStatusSelect');
  const hasChildrenField = document.getElementById('hasChildrenField');
  maritalSelect.addEventListener('change', function () {
    toggleConditional(hasChildrenField, maritalSelect.value && maritalSelect.value !== 'never_married');
  });
})();

function wireOtherToggle(triggerEl, otherFieldId, otherValue) {
  if (!triggerEl) return;
  const otherField = document.getElementById(otherFieldId);
  triggerEl.addEventListener(triggerEl.tagName === 'SELECT' ? 'change' : 'input', function () {
    toggleConditional(otherField, triggerEl.value === otherValue);
  });
}
wireOtherToggle(document.getElementById('employedInSelect'), 'employedInOtherField', 'other');
wireOtherToggle(document.getElementById('occupationInput'), 'occupationOtherField', 'Other');
wireOtherToggle(document.getElementById('hasChildrenSelect'), 'numChildrenField', 'yes_living_with_me');
document.getElementById('hasChildrenSelect').addEventListener('change', function () {
  toggleConditional(document.getElementById('numChildrenField'), this.value.startsWith('yes'));
});
wireOtherToggle(document.getElementById('motherTongueSelect'), 'motherTongueOtherField', 'Other');
</script>
  <%- include('../partials/portal-shell-close') %>
</body>
</html>
