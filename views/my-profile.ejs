<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="my-profile-page">
    <%- include('partials/flash') %>
    <div class="my-profile-heading">
      <span class="section-eyebrow"><%= t("Account") %></span>
      <h1><%= t("My Profile") %></h1>
      <p><%= t("Your account and matrimonial profile details.") %></p>
    </div>

    <section class="my-profile-card">
      <div class="my-profile-account">
        <span class="my-profile-avatar"><i class="fa-solid fa-user"></i></span>
        <div>
          <h2><%= user.name %></h2>
          <span class="badge badge-approved"><%= t("Approved member") %></span>
        </div>
      </div>
      <dl class="my-profile-details">
        <div><dt><%= t("Username") %></dt><dd><%= user.username %></dd></div>
        <div><dt><%= t("Mobile number") %></dt><dd><%= user.mobile_number %></dd></div>
        <div><dt><%= t("Gender") %></dt><dd><%= t(user.gender === 'male' ? 'Male' : user.gender === 'female' ? 'Female' : '—') %></dd></div>
      </dl>
    </section>

    <% if (profile) { %>
      <section class="my-profile-card">
        <div class="my-profile-section-heading">
          <div>
            <span class="section-eyebrow"><%= t("Matrimonial profile") %></span>
            <h2><%= profile.full_name %><% if (profile.age) { %>, <%= profile.age %><% } %></h2>
          </div>
          <% if (profile.image_name) { %>
            <img class="my-profile-photo" src="<%= fileUrl('profiles', profile.image_name) %>" alt="Profile photo for <%= profile.full_name %>">
          <% } %>
        </div>
        <dl class="my-profile-details">
          <div><dt><%= t("Marital status") %></dt><dd><%= t(profile.marital_status || '—') %></dd></div>
          <div><dt><%= t("Religion") %></dt><dd><%= profile.religion === 'other' ? (profile.religion_other || t('Other'))  : t(profile.religion || '—') %></dd></div>
          <div><dt><%= t("Caste / Sub-caste") %></dt><dd><%= t(profile.caste || '—') %><%= profile.subcaste ? ' / ' + profile.subcaste : '' %></dd></div>
          <div><dt><%= t("Education") %></dt><dd><%= t(profile.education || '—') %></dd></div>
          <div><dt><%= t("Occupation") %></dt><dd><%= profile.occupation === 'Other' ? (profile.occupation_other || t('Other'))  : t(profile.occupation || '—') %></dd></div>
          <div><dt><%= t("Location") %></dt><dd><%= [profile.city, profile.state, profile.country].filter(Boolean).join(', ') || '—' %></dd></div>
          <div><dt><%= t("Mother tongue") %></dt><dd><%= profile.mother_tongue === 'Other' ? (profile.mother_tongue_other || t('Other'))  : t(profile.mother_tongue || profile.language || '—') %></dd></div>
          <div><dt><%= t("Date of birth") %></dt><dd><%= profile.date_of_birth || '—' %><%= profile.time_of_birth ? ' · ' + profile.time_of_birth : '' %></dd></div>
          <div><dt><%= t("Birth place") %></dt><dd><%= profile.birth_place || '—' %></dd></div>
          <div><dt><%= t("Family type") %></dt><dd><%= t(profile.family_type || '—') %></dd></div>
          <div><dt><%= t("Family values") %></dt><dd><%= t(profile.family_values || '—') %></dd></div>
          <div><dt><%= t("Family status") %></dt><dd><%= t(profile.family_status || '—') %></dd></div>
          <div><dt><%= t("Father") %></dt><dd><%= profile.father_name || '—' %><%= profile.father_occupation ? ' · ' + profile.father_occupation : '' %></dd></div>
          <div><dt><%= t("Mother") %></dt><dd><%= profile.mother_name || '—' %><%= profile.mother_occupation ? ' · ' + profile.mother_occupation : '' %></dd></div>
          <div><dt><%= t("Rashi / Nakshatra") %></dt><dd><%= [profile.rashi, profile.nakshatra].filter(Boolean).map(t).join(' / ') || '—' %></dd></div>
          <div><dt><%= t("Annual income") %></dt><dd><%= t(profile.annual_income_band || profile.annual_salary || '—') %></dd></div>
          <div><dt><%= t("Address") %></dt><dd><%= [profile.address, profile.city, profile.state, profile.country].filter(Boolean).join(', ') || '—' %></dd></div>
        </dl>
      </section>
    <% } else { %>
      <section class="my-profile-card my-profile-empty">
        <span class="my-profile-empty-icon"><i class="fa-regular fa-address-card"></i></span>
        <h2><%= t("Your matrimonial profile is not available yet") %></h2>
        <p><%= t("Please contact the admin team if you need help adding or updating your profile.") %></p>
      </section>
    <% } %>

    <aside class="my-profile-help">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      <p><%= t("Need to change any details? Please") %> <a href="/#contact"><%= t("contact the admin team") %></a> <%= t("and they’ll be happy to help.") %></p>
    </aside>

    <div class="my-profile-actions">
      <a href="/dashboard" class="btn btn-gold"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> <%= t('nav.findMatch') %></a>
      <a href="/saved-profiles" class="btn btn-outline-gold my-profile-outline"><i class="fa-solid fa-bookmark" aria-hidden="true"></i> <%= t('nav.savedProfiles') %></a>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
